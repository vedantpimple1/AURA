{
  "name": "aura-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx tsx --env-file=.env src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "test": "npx tsx --env-file=.env --test --test-concurrency=1 tests/*.test.ts",
    "worker": "npx tsx --env-file=.env src/worker.ts",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:seed": "npx tsx --env-file=.env prisma/seed.ts",
    "db:studio": "npx prisma studio"
  },
  "prisma": {
    "seed": "npx tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^18.0.4",
    "prisma": "7.10.0",
    "tsx": "^4.19.4",
    "typescript": "^5"
  },
  "description": "KAI Aura — Backend API Server (Express + Prisma + BullMQ)",
  "main": "dist/src/server.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}

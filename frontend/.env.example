# ============================================================
# KAI Aura — Frontend Environment Variables
# ============================================================

# Backend API Base URL (server-side calls and Server Actions)
API_URL="http://localhost:4000/api"

# Backend API Base URL (client-side browser calls)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# JWT Secret (for fast client/edge token decode; matches backend)
JWT_SECRET="your-jwt-secret-min-32-chars"
